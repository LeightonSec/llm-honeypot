# Example placeholders only — replace with real values before running. Not real credentials.
DASHBOARD_SECRET=change-me-to-a-strong-random-secret  # gate: ignore — example placeholder

# Set to 1 only when running behind a trusted reverse proxy (nginx, Cloudflare, etc.)
# that sets X-Forwarded-For. Leave as 0 for direct internet exposure.
TRUST_PROXY=0

# --- Phase B semantic layer (default OFF — DECISIONS.md P3-V / G2-W) ---------
# With 0/unset the judge never runs: no key, no egress, no spend — Phase A
# behaviour exactly. Only set ANTHROPIC_API_KEY when SEMANTIC_ENABLED=1, and
# only a DEDICATED spend-capped key (P2); never configure a key nothing uses.
SEMANTIC_ENABLED=0
# ANTHROPIC_API_KEY=   (uncomment + fill ONLY when SEMANTIC_ENABLED=1)

# Budget caps are COST/DoS bounds, not tuned detection thresholds (P3-V):
# worst case at these defaults is single-digit cents/hour on Haiku-class
# pricing. Values below are the defaults — uncomment to override.
# SEMANTIC_HOURLY_CAP=60
# SEMANTIC_DAILY_CAP=300
# SEMANTIC_PER_SOURCE_HOURLY=5
# SEMANTIC_BREAKER_CONSECUTIVE_ERRORS=3
# SEMANTIC_BREAKER_COOLDOWN_SECONDS=900
