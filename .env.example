# Example placeholders only — replace with real values before running. Not real credentials.
# NOTE: no ANTHROPIC_API_KEY — detection is fully local. Phase B (ai-firewall
# library integration) will reintroduce it; never configure a key nothing uses.
DASHBOARD_SECRET=change-me-to-a-strong-random-secret  # gate: ignore — example placeholder

# Set to 1 only when running behind a trusted reverse proxy (nginx, Cloudflare, etc.)
# that sets X-Forwarded-For. Leave as 0 for direct internet exposure.
TRUST_PROXY=0
